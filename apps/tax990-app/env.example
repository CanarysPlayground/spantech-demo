# Demo placeholder for the per-environment .env Jenkins copied in from
# /home/ubuntu/.envs/tax990/<Environment>/<Application>
#
# In the real migration this becomes either:
#   - a GitHub encrypted secret (small values), or
#   - a self-hosted runner path (if the runner lives on the same box Jenkins used), or
#   - a secrets manager (AWS Secrets Manager / Vault) pulled at deploy time
APP_NAME=tax990-app
NODE_ENV=sprint
